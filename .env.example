# Mujo Storefront — environment variable inventory.
# Copy this file to .env.local and fill in values. .env.local is gitignored.
# See docs/env-vars.md for prose explanation of each var.

# --- Shopify Storefront API (W1: reads — products, collections, inventory) ---
# Get from: Shopify admin → Headless channel → Mujo Headless storefront → Storefront API → Private access token (shpat_...)
SHOPIFY_STORE_DOMAIN=get-mujo.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Random hex string used by /api/revalidate to authenticate Shopify webhooks. Generate with: openssl rand -hex 32
SHOPIFY_REVALIDATION_SECRET=

# --- Shopify Admin API (W2: writes — orders, metafields, customers) ---
# Strategy TBD in W2 (Develop-apps custom-app flow deprecated 2026; will use Headless channel Admin token if available, else Dev Dashboard custom-distribution OAuth).
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2025-01

# --- Stripe (W2: checkout + subscriptions + portal) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Shipping rate IDs — populated after the mirror script in W2 creates them.
STRIPE_SHIPPING_FREE_ID=
STRIPE_SHIPPING_FLAT_ID=

# --- Vercel Postgres (W1 Step 14 → 15: schema empty in W1; W2 populates) ---
# Auto-injected by Vercel via `vercel env pull` once Postgres is connected to the project.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Resend (W2: transactional email — magic-link, migration) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@mujo.life
# 64-char random hex used to sign magic-link JWTs. Generate with: openssl rand -hex 64
MAGIC_LINK_SECRET=

# --- Klaviyo (W3: email capture + server-side events) ---
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LEMNA_LIST_ID=
KLAVIYO_LEMNA_FORM_ID=

# --- Meta (W3: client pixel + Conversions API server events) ---
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=

# --- Okendo (W3: review widget) ---
NEXT_PUBLIC_OKENDO_SUBSCRIBER_ID=

# --- App config ---
# Local dev = http://localhost:3000. Vercel Production = https://mujoworld.com (set at W3 cutover).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# --- Vercel Commerce defaults (template UI strings) ---
COMPANY_NAME=Mujo Co.
SITE_NAME=Mujo Storefront
